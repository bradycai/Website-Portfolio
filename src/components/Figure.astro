---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** "phone" frames a tall mobile screenshot at phone width. */
  variant?: "wide" | "phone";
}

const { src, alt, caption, variant = "wide" } = Astro.props;
const sizes = variant === "phone" ? "320px" : "(min-width: 1100px) 820px, 100vw";
---

<figure class:list={["figure", variant]} data-reveal="media">
  <div class="frame">
    <Image src={src} alt={alt} widths={variant === "phone" ? [320, 640, 960] : [720, 1080, 1640, 2400]} sizes={sizes} />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin-block: 2.2em;
  }

  .frame {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }

  .frame :global(img) {
    width: 100%;
  }

  .phone .frame {
    max-width: 300px;
    margin-inline: auto;
    border-radius: 28px;
  }

  figcaption {
    max-width: 62ch;
    margin-top: 12px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }

  .phone figcaption {
    margin-inline: auto;
    text-align: center;
  }
</style>
