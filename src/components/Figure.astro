---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** "phone" frames a tall mobile screenshot at phone width. */
  variant?: "wide" | "phone";
}

const { src, alt, caption, variant = "wide" } = Astro.props;
const sizes = variant === "phone" ? "320px" : "(min-width: 1100px) 820px, 100vw";
// A sharper copy for the click-to-zoom view.
const zoom = await getImage({ src, width: Math.min(src.width, 2400), format: "webp" });
---

<figure class:list={["figure", variant]} data-reveal="media">
  <button class="frame zoomable" type="button" data-zoom={zoom.src} data-zoom-alt={alt} aria-label={`Enlarge image: ${alt}`}>
    <Image src={src} alt={alt} widths={variant === "phone" ? [320, 640, 960] : [720, 1080, 1640, 2400]} sizes={sizes} />
    <span class="zoom-hint" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="14" height="14"><path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </span>
  </button>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin-block: 2.2em;
  }

  .frame {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    cursor: zoom-in;
  }

  .frame :global(img) {
    width: 100%;
  }

  .phone .frame {
    max-width: 300px;
    margin-inline: auto;
    border-radius: 28px;
  }

  figcaption {
    max-width: 62ch;
    margin-top: 12px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }

  .phone figcaption {
    margin-inline: auto;
    text-align: center;
  }
</style>
