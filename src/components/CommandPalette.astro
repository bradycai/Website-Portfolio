---
// ⌘K / Ctrl+K command menu: jump anywhere, copy an email, switch theme.
// Behavior lives in src/scripts/palette.ts.
import { getCollection } from "astro:content";
import { profile } from "../data/profile";
import { url } from "../lib/url";
import { getGitHubSnapshot } from "../lib/github";

type Item = {
  label: string;
  hint?: string;
  href?: string;
  external?: boolean;
  action?: "copy" | "theme";
  value?: string;
  keywords?: string;
  icon: keyof typeof icons;
};

const icons = {
  page: "M6 3h8l4 4v14H6zM14 3v4h4",
  hash: "M9 4 7 20M17 4l-2 16M4 9h16M3 15h16",
  file: "M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6",
  case: "M4 7h16v12H4zM9 7V5h6v2",
  copy: "M9 9h11v11H9zM5 15V4h11",
  theme: "M12 3a9 9 0 1 0 0 18zM12 3a9 9 0 0 1 0 18",
  out: "M8 8h8v8M8 16l8-8",
} as const;

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const snapshot = await getGitHubSnapshot();

const groups: { name: string; items: Item[] }[] = [
  {
    name: "Pages",
    items: [
      { label: "Home", href: url(""), icon: "page", keywords: "start top index" },
      { label: "Work", href: url("#work"), icon: "hash", keywords: "projects portfolio" },
      { label: "All GitHub projects", href: url("#more"), icon: "hash", keywords: "explore search repositories library" },
      { label: "How I build", href: url("#approach"), icon: "hash", keywords: "approach principles" },
      { label: "Experience", href: url("#experience"), icon: "hash", keywords: "jobs co-op internship" },
      { label: "About", href: url("#about"), icon: "hash", keywords: "education skills school" },
      { label: "Contact", href: url("#contact"), icon: "hash", keywords: "email hire reach" },
      { label: "Résumé", hint: "Printable, one page", href: url("resume/"), icon: "file", keywords: "resume cv pdf download print" },
    ],
  },
  {
    name: "Case studies",
    items: projects.map((p) => ({
      label: p.data.title,
      hint: p.data.kind,
      href: url(`projects/${p.id}/`),
      icon: "case" as const,
      keywords: `${p.data.stack.join(" ")} ${p.data.summary}`,
    })),
  },
  {
    name: "GitHub projects",
    items: snapshot.projects.filter((p) => !p.caseStudy).map((p) => ({
      label: p.title, hint: p.category, href: p.url, external: true,
      icon: "out" as const, keywords: `${p.name} ${p.stack.join(" ")} ${p.description}`,
    })),
  },
  {
    name: "Actions",
    items: [
      ...profile.emails.map((e) => ({
        label: `Copy ${e.label.toLowerCase()} email`,
        hint: e.address,
        action: "copy" as const,
        value: e.address,
        icon: "copy" as const,
        keywords: "mail address contact",
      })),
      { label: "Switch theme", hint: "Light or dark", action: "theme", icon: "theme", keywords: "dark light mode appearance" },
    ],
  },
  {
    name: "Links",
    items: [
      { label: "GitHub", hint: "github.com/bradycai", href: profile.github, external: true, icon: "out", keywords: "code repos" },
      { label: "LinkedIn", hint: "linkedin.com/in/bradycai", href: profile.linkedin, external: true, icon: "out", keywords: "profile" },
      { label: "Source code for this site", hint: "Astro", href: profile.sourceRepo, external: true, icon: "out", keywords: "repo github" },
    ],
  },
];

let n = 0;
const withIds = groups.map((g) => ({ ...g, items: g.items.map((item) => ({ ...item, id: `cmd-${n++}` })) }));
---

<dialog class="palette" data-palette aria-label="Command menu">
  <div class="palette-box">
    <div class="palette-search">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
        <path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
      </svg>
      <input
        type="text"
        data-palette-input
        placeholder="Search pages, projects, and actions"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd>esc</kbd>
    </div>

    <div class="palette-list" id="palette-list" role="listbox" aria-label="Commands" data-palette-list>
      {withIds.map((group) => (
        <div class="palette-group" role="group" aria-labelledby={`${group.items[0]?.id}-group`} data-group>
          <p class="palette-group-label" id={`${group.items[0]?.id}-group`}>{group.name}</p>
          {group.items.map((item) => (
            <div
              class="palette-item"
              role="option"
              id={item.id}
              aria-selected="false"
              data-item
              data-href={item.href}
              data-external={item.external ? "" : undefined}
              data-action={item.action}
              data-value={item.value}
              data-search={`${item.label} ${item.hint ?? ""} ${item.keywords ?? ""} ${group.name}`.toLowerCase()}
            >
              <svg class="palette-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d={icons[item.icon]} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <span class="palette-label">{item.label}</span>
              {item.hint && <span class="palette-hint">{item.hint}</span>}
              <span class="palette-enter" aria-hidden="true">↵</span>
            </div>
          ))}
        </div>
      ))}
      <p class="palette-empty" data-palette-empty hidden>No matches. Try “resume”, “email”, or a project name.</p>
    </div>

    <div class="palette-foot" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
    </div>
  </div>
</dialog>

<style>
  .palette {
    width: min(620px, calc(100vw - 32px));
    max-height: min(560px, calc(100dvh - 64px));
    margin: 14vh auto auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    background: var(--bg);
    color: var(--fg);
    box-shadow:
      0 2px 6px rgba(0, 0, 0, 0.06),
      0 40px 80px -24px rgba(0, 0, 0, 0.45);
    opacity: 0;
    transform: translateY(8px) scale(0.985);
    transition:
      opacity 0.22s var(--ease-out),
      transform 0.32s var(--ease-out),
      overlay 0.32s allow-discrete,
      display 0.32s allow-discrete;
  }

  .palette[open] {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .palette[open] {
      opacity: 0;
      transform: translateY(8px) scale(0.985);
    }
  }

  .palette::backdrop {
    background: rgba(10, 10, 9, 0.28);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    opacity: 0;
    transition: opacity 0.25s, overlay 0.25s allow-discrete, display 0.25s allow-discrete;
  }

  .palette[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    .palette[open]::backdrop {
      opacity: 0;
    }
  }

  .palette-box {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }

  .palette-search {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  .palette-search input {
    flex: 1;
    min-width: 0;
    padding: 4px 0;
    border: 0;
    outline: 0;
    background: none;
    color: var(--fg);
    font: inherit;
    font-size: 17px;
    letter-spacing: -0.01em;
  }

  .palette-search input::placeholder {
    color: var(--muted);
  }

  kbd {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 500;
    line-height: 1;
  }

  .palette-list {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 6px 8px 10px;
  }

  .palette-group[hidden] {
    display: none;
  }

  .palette-group-label {
    padding: 10px 10px 4px;
    color: var(--muted);
    font-size: 12.5px;
    font-weight: 500;
  }

  .palette-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 10px;
    border-radius: 10px;
    cursor: pointer;
    scroll-margin: 8px;
  }

  .palette-item[hidden] {
    display: none;
  }

  .palette-item[aria-selected="true"] {
    background: var(--hover);
  }

  .palette-icon {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--muted);
  }

  .palette-label {
    font-size: 15px;
    font-weight: 500;
  }

  .palette-hint {
    overflow: hidden;
    color: var(--muted);
    font-size: 13.5px;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .palette-enter {
    margin-left: auto;
    color: var(--muted);
    font-size: 13px;
    opacity: 0;
  }

  .palette-item[aria-selected="true"] .palette-enter {
    opacity: 1;
  }

  .palette-empty {
    padding: 28px 12px;
    color: var(--muted);
    font-size: 15px;
    text-align: center;
  }

  .palette-foot {
    display: flex;
    gap: 16px;
    padding: 10px 16px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 12.5px;
  }

  .palette-foot span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  @media (max-width: 560px) {
    .palette {
      margin-top: 10vh;
    }

    .palette-hint {
      display: none;
    }

    .palette-foot {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .palette,
    .palette::backdrop {
      transition: none;
    }
  }
</style>
