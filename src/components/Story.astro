---
// Sticky walkthrough: steps scroll on the left while the matching screenshot
// stays pinned on the right and crossfades as each step reaches the middle.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  tint: string;
  steps: { title: string; body: string; image: ImageMetadata; alt: string }[];
}

const { title, tint, steps } = Astro.props;
const shotWidths = [720, 1080, 1440, 2160];
---

<section class="story" data-story aria-label={title}>
  <div class="container story-grid">
    <div class="story-steps">
      <h2 class="story-title">{title}</h2>
      {steps.map((step, i) => (
        <div class:list={["story-step", { "is-active": i === 0 }]} data-step={i}>
          <p class="story-n tabular">{String(i + 1).padStart(2, "0")}</p>
          <h3>{step.title}</h3>
          <p class="story-body">{step.body}</p>
          <div class="story-inline" style={`--tint: ${tint}`}>
            <Image src={step.image} alt={step.alt} widths={shotWidths} sizes="100vw" />
          </div>
        </div>
      ))}
    </div>

    <div class="story-media" aria-hidden="true">
      <div class="story-frame" style={`--tint: ${tint}`}>
        {steps.map((step, i) => (
          <Image
            class:list={["story-shot", { "is-active": i === 0 }]}
            data-shot={i}
            src={step.image}
            alt=""
            widths={shotWidths}
            sizes="(min-width: 1240px) 700px, 58vw"
          />
        ))}
        <div class="story-dots">
          {steps.map((_, i) => <span class:list={{ "is-active": i === 0 }} data-dot={i}></span>)}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .story {
    padding-block: clamp(48px, 7vw, 96px);
  }

  .story-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
  }

  .story-steps {
    grid-column: 1 / span 4;
  }

  .story-title {
    color: var(--muted);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .story-step {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 72vh;
    opacity: 0.3;
    transition: opacity 0.6s var(--ease-out);
  }

  .story-step.is-active {
    opacity: 1;
  }

  .story-step:first-of-type {
    min-height: 60vh;
  }

  .story-n {
    color: var(--accent);
    font-size: 14px;
    font-weight: 600;
  }

  .story-step h3 {
    margin-top: 10px;
    font-size: clamp(26px, 2.6vw, 34px);
    font-weight: 520;
    font-stretch: 90%;
    letter-spacing: -0.035em;
  }

  .story-body {
    max-width: 34ch;
    margin-top: 12px;
    color: var(--fg-2);
    font-size: 17px;
  }

  .story-inline {
    display: none;
  }

  .story-media {
    grid-column: 6 / -1;
  }

  .story-frame {
    position: sticky;
    top: calc(var(--header-h) + 8vh);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 14px;
    background: var(--tint);
  }

  .story-shot {
    position: absolute;
    left: 6%;
    top: 7%;
    width: 88%;
    height: auto;
    border-radius: 8px;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.1),
      0 30px 70px -28px rgba(0, 0, 0, 0.6);
    opacity: 0;
    transform: translateY(14px) scale(0.985);
    transition:
      opacity 0.7s var(--ease-out),
      transform 0.9s var(--ease-out);
  }

  .story-shot.is-active {
    opacity: 1;
    transform: none;
  }

  .story-dots {
    position: absolute;
    right: 16px;
    bottom: 14px;
    display: flex;
    gap: 6px;
  }

  .story-dots span {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.35);
    transition: width 0.5s var(--ease-out), background-color 0.3s;
  }

  .story-dots span.is-active {
    width: 18px;
    background: #fff;
  }

  /* Phones and tablets: no pinning, each step carries its own screenshot. */
  @media (max-width: 900px) {
    .story-steps {
      grid-column: 1 / -1;
    }

    .story-media {
      display: none;
    }

    .story-step,
    .story-step:first-of-type {
      min-height: 0;
      padding-top: 40px;
      opacity: 1;
    }

    .story-inline {
      display: block;
      margin-top: 20px;
      padding: 5% 5% 0;
      overflow: hidden;
      border-radius: 12px;
      background: var(--tint);
    }

    .story-inline :global(img) {
      width: 100%;
      border-radius: 6px 6px 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story-step,
    .story-shot {
      transition: none;
    }
  }
</style>
