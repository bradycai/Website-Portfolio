---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import ProjectCover from "../components/ProjectCover.astro";
import ProjectLibrary from "../components/ProjectLibrary.astro";
import FeaturedPreview from "../components/FeaturedPreview.astro";
import PortfolioMetrics from "../components/PortfolioMetrics.astro";
import LogoWall from "../components/LogoWall.astro";
import IsoDrawing from "../components/IsoDrawing.astro";
import headshot from "../assets/headshot.jpg";
import { profile, primaryEmail, experience, education, skills } from "../data/profile";
import { getGitHubSnapshot } from "../lib/github";
import { url } from "../lib/url";
import "../styles/portfolio.css";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const snapshot = await getGitHubSnapshot();
const notes: Record<string, { label: string; title: string; body: string; color: string }> = {
  ordersync: { label: "01 / AI + OPERATIONS", title: "Less busywork. More business.", body: "An AI-assisted command center for sellers juggling orders across four marketplaces. Won first place in the Misneach challenge at AINU, then rebuilt on Postgres with roles and a sync engine.", color: "mint" },
  "trading-assistant": { label: "02 / AI + FINANCE", title: "Smart ideas. Hard guardrails.", body: "A full-stack research and trading system where AI makes recommendations and a deterministic risk engine checks every order.", color: "lavender" },
  "frogs-videography": { label: "03 / DESIGN + DEVELOPMENT", title: "A better stage for their stories.", body: "A custom website for a New England video production company. Designed, developed, and launched from the first layout to the final domain.", color: "peach" },
};
const principles = [
  { drawing: "layers" as const, title: "Useful AI. Clear boundaries.", body: "AI handles the messy inputs. Plain code handles the math. People stay in control.", project: "OrderSync", slug: "ordersync" },
  { drawing: "gates" as const, title: "Confidence comes from constraints.", body: "Good automation earns trust with checks, tests, and a trail you can follow.", project: "AI Trading Assistant", slug: "trading-assistant" },
  { drawing: "modules" as const, title: "Built for the next person.", body: "Readable code and simple configuration make a product easier to keep improving.", project: "Frogs Videography", slug: "frogs-videography" },
];
const personJsonLd = {
  "@context": "https://schema.org", "@type": "Person", name: profile.name,
  url: new URL(url(""), Astro.site).href, email: `mailto:${primaryEmail}`,
  jobTitle: profile.title, sameAs: [profile.github, profile.linkedin],
  affiliation: { "@type": "CollegeOrUniversity", name: education.school },
};
---

<Base isHome>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  <div class="portfolio-home">
    <section class="portfolio-hero" aria-labelledby="hero-name">
      <div class="hero-glow" aria-hidden="true" />
      <div class="container">
        <div class="hero-layout">
          <div class="hero-copy">
            <p class="eyebrow hero-enter"><span class="eyebrow-line" /> BRADY CAI · SOFTWARE ENGINEER</p>
            <h1 id="hero-name" class="hero-enter" style="--delay: 80ms"><span class="hero-line">Curiosity in.</span><span class="hero-line">Good software</span><span class="hero-line hero-accent">out<span class="hero-asterisk" aria-hidden="true">✳</span><span class="hero-period">.</span></span></h1>
            <p class="hero-description hero-enter" style="--delay: 160ms">I build thoughtful software for real-world problems.<br class="desktop-break" /> Full-stack products, useful AI, and the details<br class="desktop-break" /> that make them feel right.</p>
            <div class="hero-buttons hero-enter" style="--delay: 240ms">
              <a class="btn btn-primary" href="#work">Explore my work <span class="arrow arrow-right" aria-hidden="true">↗</span></a>
              <a class="hero-github" href={profile.github} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true"><path d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.76-.24.76-.54v-2.1c-3.12.68-3.78-1.33-3.78-1.33-.5-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.68.08-.68 1.13.08 1.73 1.16 1.73 1.16 1 1.73 2.63 1.23 3.27.94.1-.73.39-1.23.71-1.51-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.24 1.16-3.03-.12-.29-.5-1.43.11-2.98 0 0 .94-.3 3.08 1.15A10.7 10.7 0 0 1 12 6.12c.95 0 1.9.13 2.8.38 2.13-1.45 3.07-1.15 3.07-1.15.61 1.55.23 2.69.11 2.98.72.8 1.16 1.8 1.16 3.03 0 4.32-2.64 5.27-5.15 5.55.4.35.76 1.03.76 2.07v3.11c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8Z" /></svg>GitHub<span aria-hidden="true">↗</span></a>
            </div>
            <div class="hero-person hero-enter" style="--delay: 320ms">
              <Image src={headshot} alt="Brady Cai" width={44} height={44} priority />
              <div><span>CS + Business @ Northeastern</span><p><span class="dot" aria-hidden="true" /> Open to summer 2027 internships</p></div>
            </div>
          </div>
          <FeaturedPreview projects={projects} />
        </div>
        <div class="hero-bottom"><p><span class="dot" aria-hidden="true" /> Currently building at <strong>NExT Consulting</strong></p><p>{profile.location} <span class="hero-divider">/</span> <time data-clock={profile.timeZone} /></p><a href="#work">Scroll to explore <span aria-hidden="true">↓</span></a></div>
      </div>
    </section>

    <PortfolioMetrics />
    <LogoWall />

    <div class="project-marquee" aria-hidden="true"><div class="marquee-track">{[0, 1].map(() => <span>USEFUL AI <i>✳</i> THOUGHTFUL INTERFACES <i>✳</i> REAL-WORLD PRODUCTS <i>✳</i> ALWAYS BUILDING <i>✳</i> </span>)}</div></div>

    <section class="portfolio-section featured-section" id="work" aria-labelledby="work-title">
      <div class="container">
        <div class="section-heading" data-reveal><div><p class="eyebrow"><span class="section-number">01</span> SELECTED WORK</p><h2 id="work-title">Less talk.<br /><span>More shipped.</span></h2></div><div class="heading-aside"><p>A few projects I’m proud of. <br />The problem, the process, and the product.</p><a class="text-link" href="#more">Explore all <span data-project-total>{snapshot.repoCount}</span> projects <span aria-hidden="true">↗</span></a></div></div>
        <div class="featured-grid">
          {projects.map((project, i) => {
            const note = notes[project.id];
            const href = url(`projects/${project.id}/`);
            return <article class:list={["feature-card", `feature-${project.id}`, "spotlight", { "feature-wide": i === 0 }]} data-reveal>
              <a class="feature-media cover-link" href={href} aria-label={`Explore ${project.data.title}`}>
                <span class={`feature-badge ${note.color}`}>{i === 0 ? "✦ HACKATHON WINNER" : i === 1 ? "AI + DETERMINISTIC RISK" : "● LIVE CLIENT WEBSITE"}</span>
                <ProjectCover project={project} sizes={i === 0 ? "(min-width: 1100px) 720px, 100vw" : "(min-width: 1100px) 600px, 100vw"} />
              </a>
              <div class="feature-content"><p class="feature-kicker">{note.label}</p><h3><a href={href}><span transition:name={`title-${project.id}`}>{project.data.title}</span><span class="feature-title-arrow" aria-hidden="true">↗</span></a></h3><p class="feature-tagline">{note.title}</p><p class="feature-description">{note.body}</p>
                <ul class="tech-tags">{project.data.stack.slice(0, 4).map((tech) => <li>{tech}</li>)}</ul>
                <div class="feature-stats">{project.data.stats.slice(0, 2).map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}</div>
                <div class="feature-actions"><a class="text-link" href={href}>Inside the project <span class="arrow arrow-right" aria-hidden="true">→</span></a><div>{project.data.links.live && <a href={project.data.links.live} target="_blank" rel="noopener">Live site ↗</a>}{project.data.links.code && <a href={project.data.links.code} target="_blank" rel="noopener">GitHub ↗</a>}</div></div>
              </div>
            </article>;
          })}
        </div>
      </div>
    </section>

    <section class="portfolio-section explorer-section" id="more" aria-labelledby="more-title">
      <div class="container">
        <div class="section-heading" data-reveal><div><p class="eyebrow"><span class="section-number">02</span> THE PROJECT LIBRARY</p><h2 id="more-title">Always building.<br /><span>Always curious.</span></h2></div><div class="heading-aside"><p>Apps, experiments, client work, and team projects. <br />Every public project, in one place.</p><a class="text-link" href={`${profile.github}?tab=repositories`} target="_blank" rel="noopener">github.com/bradycai <span aria-hidden="true">↗</span></a></div></div>
        <ProjectLibrary />
      </div>
    </section>

    <section class="portfolio-section experience-section" id="experience" aria-labelledby="experience-title">
      <div class="container experience-layout">
        <div class="experience-intro" data-reveal><p class="eyebrow"><span class="section-number">03</span> IN GOOD COMPANY</p><h2 id="experience-title">Real teams.<br /><span>Real impact.</span></h2><p>I like working where I can own a problem, learn from good people, and ship something useful.</p><a class="text-link" href={url("resume/")}>View my résumé <span aria-hidden="true">↗</span></a></div>
        <ol class="experience-list">{experience.map((job, i) => <li class="experience-item" data-reveal><div class="experience-marker" aria-hidden="true">{i === 0 ? "N" : "F"}<span /></div><div class="experience-detail"><div class="experience-top"><p>{job.period}</p>{job.current && <span class="current-label"><span class="dot" />CURRENT</span>}</div><h3>{job.role}</h3><p class="experience-company">{job.company} <span>· {job.location}</span></p><p class="experience-summary">{job.summary}</p><ul class="tech-tags">{job.stack.map((tech) => <li>{tech}</li>)}</ul>{job.caseStudy && <a class="text-link experience-case" href={url(`projects/${job.caseStudy}/`)}>Explore the work <span aria-hidden="true">↗</span></a>}</div></li>)}</ol>
      </div>
    </section>

    <section class="portfolio-section about-section" id="about" aria-labelledby="about-title">
      <div class="container">
        <div class="section-heading" data-reveal><div><p class="eyebrow"><span class="section-number">04</span> THE PERSON BEHIND THE CODE</p><h2 id="about-title">Hi, I’m Brady<span class="accent">.</span></h2></div><p class="about-side-note">Engineer by practice.<br />Curious by default.</p></div>
        <div class="about-layout"><div class="about-photo" data-reveal><Image src={headshot} alt="Brady Cai, software engineer and Northeastern student" widths={[360, 600, 900]} sizes="(min-width: 900px) 360px, 90vw" /><div class="photo-caption"><span>BOSTON, MA</span><span aria-hidden="true">↗</span></div></div><div class="about-copy" data-reveal><p class="about-lead">I’m interested in the space between<br class="desktop-break" /> <span>“what if?”</span> and <span>“it works.”</span></p><p>I study computer science and business at Northeastern’s Khoury College, graduating in 2028. I’m currently a software engineer co-op at NExT Consulting, working on RepoPulse.</p><p>Most of my projects live where software meets everyday operations: the orders a small business manages, the decisions a trading system makes, or the website a client relies on. I enjoy making those experiences clearer, faster, and easier to use.</p><div class="education-note"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="m2 9 10-5 10 5-10 5L2 9Zm4 2v6c4 3 8 3 12 0v-6M22 9v8" /></svg><div><strong>{education.school}</strong><p>{education.degree} <span>· Class of 2028</span></p></div></div></div></div>
        <div class="skills-block" data-reveal><p class="eyebrow">MY EVERYDAY TOOLKIT</p><div class="skills-grid">{skills.slice(0, 4).map((group) => <div><h3>{group.group}</h3><p>{group.items.join(" · ")}</p></div>)}</div></div>
      </div>
    </section>

    <section class="portfolio-section approach-section" id="approach" aria-labelledby="approach-title"><div class="container"><div class="approach-heading" data-reveal><p class="eyebrow">A LITTLE ABOUT THE PROCESS</p><h2 id="approach-title">Thoughtful from the inside out.</h2></div><div class="approach-grid">{principles.map((p, i) => <article class="approach-card" data-reveal><div class="approach-art"><IsoDrawing kind={p.drawing} /><span>0{i + 1}</span></div><h3>{p.title}</h3><p>{p.body}</p><a class="text-link" href={url(`projects/${p.slug}/`)}>{p.project} <span aria-hidden="true">↗</span></a></article>)}</div></div></section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="container"><div class="contact-panel" data-reveal><div class="contact-orbit" aria-hidden="true" /><p class="eyebrow"><span class="dot" /> OPEN TO SUMMER 2027 OPPORTUNITIES</p><h2 id="contact-title">Good things start<br />with a <span>conversation.</span></h2><p class="contact-description">Have a project in mind, or a team I’d fit into?<br />I’d love to hear about it.</p><div class="contact-buttons"><a class="btn btn-primary" href={`mailto:${primaryEmail}`}>Let’s build something <span aria-hidden="true">↗</span></a><button type="button" class="copy-email" data-copy={primaryEmail} aria-label={`Copy ${primaryEmail}`}><span data-copy-label>Copy email</span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 9h11v11H9zM5 15V4h11" /></svg></button></div><p class="contact-emails">{profile.emails.map((e) => <a class="contact-email" href={`mailto:${e.address}`}><span>{e.label}</span>{e.address}</a>)}</p><div class="contact-socials"><a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a><a href={profile.github} target="_blank" rel="noopener">GitHub ↗</a><a href={url("resume/")}>Résumé ↗</a></div></div></div></section>
  </div>
</Base>
